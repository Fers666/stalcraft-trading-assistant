# Хостовый node_modules НЕ должен попадать в образ.
#
# `COPY . .` в Dockerfile идёт после `npm install`/`npm ci` и затирает
# правильно установленные линуксовые зависимости содержимым хоста. На Windows
# симлинки из node_modules/.bin (vite -> ../vite/bin/vite.js) сериализуются в
# контекст сборки как файлы нулевого размера, поэтому в образе
# node_modules/.bin/vite весит 0 байт: `npm run dev` молча отрабатывает с
# кодом 0 (Exec format error проглатывается оболочкой), контейнер сразу
# выходит, порт 3000 никто не слушает.
#
# На сервере дефект не проявлялся — там репозиторий клонируется без
# node_modules, и COPY просто нечего было ломать.
node_modules
dist

# Мусор, который тоже незачем тащить в контекст сборки
.git
.gitignore
*.log
.env
.env.*
.vscode
.idea
